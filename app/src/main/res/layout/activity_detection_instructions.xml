<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp"
        android:paddingHorizontal="28dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:layout_marginStart="-8dp"
            android:src="@drawable/ic_chevron_left_white"
            android:padding="8dp"
            android:contentDescription="@null"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:lineSpacingExtra="4dp"
            tools:text="Alphabet Detection Instructions"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            xmlns:tools="http://schemas.android.com/tools" />

        <FrameLayout
            android:id="@+id/imgCameraBox"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_camera_icon_box"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera_large_white"
                android:contentDescription="@null" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/imgCameraBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Bullet 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_checklist_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_small_white"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/instructions_bullet1"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/baloo2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Bullet 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_checklist_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_small_white"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/instructions_bullet2"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/baloo2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Bullet 3 (text set dynamically per type) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_checklist_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_small_white"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txtBullet3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/baloo2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="Form the sign language letter gestures one at a time."
                    xmlns:tools="http://schemas.android.com/tools" />

            </LinearLayout>

            <!-- Bullet 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_checklist_circle">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_small_white"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/instructions_bullet4"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/baloo2"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnStartDetection"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_button_login"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/layoutChecklist"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_detection"
                android:textColor="@color/white"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="17sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>