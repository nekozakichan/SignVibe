<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:padding="24dp">

    <!-- Scan frame -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@color/bg_screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.15">

        <!-- Icon / emoji -->
        <TextView
            android:id="@+id/txtEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="52sp"
            tools:text="✊"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageView
            android:id="@+id/imgWordIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_word_detection"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- 4 corner brackets -->
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:src="@drawable/ic_scan_corner" android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:rotation="90"
            android:src="@drawable/ic_scan_corner" android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:rotation="180"
            android:src="@drawable/ic_scan_corner" android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="bottom|start"
            android:rotation="270"
            android:src="@drawable/ic_scan_corner" android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/baloo2"
        android:textStyle="bold"
        android:textColor="@color/teal_dark"
        android:textSize="22sp"
        tools:text="Alphabet Detection"
        app:layout_constraintTop_toBottomOf="@id/scanFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/txtDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/baloo2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Detect FSL letters A-Z"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        xmlns:tools="http://schemas.android.com/tools" />

</androidx.constraintlayout.widget.ConstraintLayout>