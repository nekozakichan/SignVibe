<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Curved header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curved"
            android:paddingTop="40dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:id="@+id/avatarFrame"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_avatar_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imgAvatarPlaceholder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person_placeholder"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/cameraBadge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_camera_badge"
                android:elevation="3dp"
                app:layout_constraintBottom_toBottomOf="@id/avatarFrame"
                app:layout_constraintEnd_toEndOf="@id/avatarFrame">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="24sp"
                tools:text="Juan dela Cruz"
                app:layout_constraintTop_toBottomOf="@id/avatarFrame"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/txtGradeSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_translucent"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:textColor="@color/white"
                android:fontFamily="@font/baloo2"
                android:textSize="14sp"
                tools:text="Grade 3 - Sampaguita"
                app:layout_constraintTop_toBottomOf="@id/txtUserName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                xmlns:tools="http://schemas.android.com/tools" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- My Progress card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:padding="20dp"
            xmlns:tools="http://schemas.android.com/tools">

            <TextView
                android:id="@+id/txtProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_progress"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="19sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <FrameLayout
                android:id="@+id/progressIconBg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_module_icon"
                app:layout_constraintTop_toBottomOf="@id/txtProgressTitle"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_book_teal"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtLessonsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/lessons_completed_label"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/baloo2"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/progressIconBg"
                app:layout_constraintStart_toEndOf="@id/progressIconBg"
                app:layout_constraintEnd_toStartOf="@id/txtProgressPercent" />

            <TextView
                android:id="@+id/txtLessonsFraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/teal_dark"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="22sp"
                tools:text="12 / 81"
                app:layout_constraintTop_toBottomOf="@id/txtLessonsLabel"
                app:layout_constraintStart_toEndOf="@id/progressIconBg" />

            <TextView
                android:id="@+id/txtProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/teal_dark"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="20sp"
                tools:text="15%"
                app:layout_constraintTop_toTopOf="@id/progressIconBg"
                app:layout_constraintBottom_toBottomOf="@id/progressIconBg"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/progressOverall"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="15"
                android:progressDrawable="@drawable/progress_bar_module"
                app:layout_constraintTop_toBottomOf="@id/progressIconBg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Stars row -->
            <FrameLayout
                android:id="@+id/starsIconBg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_module_icon"
                app:layout_constraintTop_toBottomOf="@id/progressOverall"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtStarsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/stars_earned_label"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/baloo2"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/starsIconBg"
                app:layout_constraintStart_toEndOf="@id/starsIconBg"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/teal_dark"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="22sp"
                tools:text="7"
                app:layout_constraintTop_toBottomOf="@id/txtStarsLabel"
                app:layout_constraintStart_toEndOf="@id/starsIconBg" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== Flappy Sign leaderboard ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:text="🏆 Flappy Sign Leaderboard"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtMyBest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:text="Your best: 0"
                android:textColor="#FF5A7A"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="16sp"
                tools:text="Your best: 42" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bg_screen" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/txtLeaderboardEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:text="No scores yet. Be the first to play! 🐤"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/baloo2"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/information_title"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textSize="19sp" />

        <LinearLayout
            android:id="@+id/rowAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_module_icon">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info_outline"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="@string/about_signvibe"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHowTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_module_icon_blue">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_help_outline"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="@string/how_to_use"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_button_outline_red"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_logout"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/log_out"
                android:textColor="@color/error_red"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_version"
            android:textColor="@color/field_hint"
            android:fontFamily="@font/baloo2"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>