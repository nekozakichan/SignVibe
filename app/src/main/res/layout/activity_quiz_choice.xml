<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_curved"
        android:paddingHorizontal="24dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:padding="2dp"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/white"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textSize="22sp"
            tools:text="Quiz"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:alpha="0.9"
            android:fontFamily="@font/baloo2"
            android:textSize="14sp"
            tools:text="1 of 5"
            app:layout_constraintTop_toBottomOf="@id/txtQuizTitle"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Prompt -->
    <TextView
        android:id="@+id/txtPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/quiz_choice_prompt"
        android:fontFamily="@font/baloo2"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Video with replay overlay -->
    <FrameLayout
        android:id="@+id/videoCard"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_video_rounded"
        android:clipToOutline="true"
        android:clipChildren="true"
        app:layout_constraintTop_toBottomOf="@id/txtPrompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:surface_type="texture_view"
            app:resize_mode="fit" />

        <ImageView
            android:id="@+id/btnReplay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_speak_button"
            android:padding="9dp"
            android:src="@drawable/ic_replay"
            app:tint="@color/white"
            android:contentDescription="@null" />

    </FrameLayout>

    <!-- Choices -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/videoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnChoice1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_default"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textColor="@color/teal_dark"
            android:textSize="16sp"
            tools:text="Hello" />

        <TextView
            android:id="@+id/btnChoice2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_default"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textColor="@color/teal_dark"
            android:textSize="16sp"
            tools:text="Thank you" />

        <TextView
            android:id="@+id/btnChoice3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_choice_default"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textColor="@color/teal_dark"
            android:textSize="16sp"
            tools:text="Sorry" />

        <TextView
            android:id="@+id/btnChoice4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_choice_default"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:fontFamily="@font/baloo2"
            android:textStyle="bold"
            android:textColor="@color/teal_dark"
            android:textSize="16sp"
            tools:text="Please" />

    </LinearLayout>

    <!-- ===== Answer feedback overlay =====
         Correct: "Awesome!" + thumbs-up GIF + party-popper confetti (auto-closes).
         Wrong:   "Oops, that is not correct" + oops video, then
                  "The answer is ___" + the sign video + Ok. -->
    <FrameLayout
        android:id="@+id/feedbackOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#990B3B3E"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/feedbackCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="96dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_feedback_card"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtFeedbackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="26sp"
                tools:text="Awesome!" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Circle for the Awesome GIF or the Oops video. -->
            <FrameLayout
                android:id="@+id/feedbackCircle"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:background="@drawable/bg_feedback_circle"
                android:clipToOutline="true"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/imgFeedbackGif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="30dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/quiz_feedback_correct" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/feedbackCirclePlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="zoom"
                    app:shutter_background_color="@color/white" />

            </FrameLayout>

            <!-- Rounded frame for the correct-answer sign video. -->
            <FrameLayout
                android:id="@+id/feedbackAnswerCard"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_feedback_video"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:visibility="gone">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/feedbackAnswerPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="fit"
                    app:shutter_background_color="@color/white" />

            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnFeedbackOk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feedback_ok"
                android:elevation="2dp"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="@string/quiz_feedback_ok"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Confetti floats over the card; it never takes touches. -->
        <com.ucucite.signvibe.ui.quiz.ConfettiView
            android:id="@+id/confettiView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="12dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>