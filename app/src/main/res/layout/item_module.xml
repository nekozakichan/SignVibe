<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:padding="16dp">

    <!-- Fixed 52dp icon container. Its height is explicit and cannot collapse,
         so the row height is stable no matter what the ImageView loads. Both
         the emoji TextView and the image ImageView live inside it, stacked. -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_module_icon"
            android:gravity="center"
            android:textSize="24sp"
            android:fontFamily="@font/baloo2"
            tools:text="abc" />

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_module_icon"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@null" />

    </FrameLayout>

    <ImageView
        android:id="@+id/imgChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintBottom_toBottomOf="@id/iconContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/baloo2"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        tools:text="Alphabet"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintBottom_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/imgChevron" />

    <ProgressBar
        android:id="@+id/progressModule"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_bar_module"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtLessonsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/baloo2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="0/25 lessons"
        app:layout_constraintTop_toBottomOf="@id/progressModule"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>