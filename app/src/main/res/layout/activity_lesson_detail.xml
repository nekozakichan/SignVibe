<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Flat teal AppBar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/teal_dark"
            android:paddingHorizontal="8dp"
            android:paddingTop="40dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                android:padding="8dp"
                android:contentDescription="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtLessonTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/white"
                android:fontFamily="@font/baloo2"
                android:textStyle="bold"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Letter A"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                xmlns:tools="http://schemas.android.com/tools" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Video area -->
            <FrameLayout
                android:id="@+id/videoContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_video_rounded"
                android:clipToOutline="true">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    app:use_controller="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:surface_type="texture_view"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/videoLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white" />

                <LinearLayout
                    android:id="@+id/videoEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgVideoStateIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_videocam_off"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/txtVideoStateMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/video_not_uploaded"
                        android:textColor="#61FFFFFF"
                        android:fontFamily="@font/baloo2"
                        android:textSize="13sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Letter box + Speak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_letter_box">

                    <TextView
                        android:id="@+id/txtShortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/baloo2"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        tools:text="A"
                        xmlns:tools="http://schemas.android.com/tools" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnSpeak"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_speak_button">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_volume_up_white"
                        android:contentDescription="@null" />

                </FrameLayout>

            </LinearLayout>

            <!-- Description card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info_outline"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/about_this_sign"
                        android:textColor="@color/teal_dark"
                        android:fontFamily="@font/baloo2"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtLessonDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/baloo2"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="Description of the sign goes here."
                    xmlns:tools="http://schemas.android.com/tools" />

            </LinearLayout>

            <!-- Repeat + Mark as Done -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnRepeat"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_repeat_button">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_replay"
                        android:contentDescription="@null" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/btnMarkDone"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_button_login"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle_white"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/mark_as_done"
                        android:textColor="@color/white"
                        android:fontFamily="@font/baloo2"
                        android:textStyle="bold"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>