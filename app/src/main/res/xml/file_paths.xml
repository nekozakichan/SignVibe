<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The update APK is downloaded to getExternalFilesDir(DIRECTORY_DOWNLOADS),
         which maps to the app's external-files "Download/" folder. -->
    <external-files-path
        name="apk_updates"
        path="Download/" />

    <!-- SignVibe AI: photos taken with the camera are written here (getCacheDir()/camera)
         so the camera app can save into them. Cleared each time the chat opens fresh. -->
    <cache-path
        name="camera_photos"
        path="camera/" />
</paths>
