<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/signvibe_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/signvibe_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignVibe">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.learn.LessonListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.learn.LessonDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.translate.DetectionInstructionsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.translate.DetectionCameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity android:name=".ui.quiz.QuizTracingActivity" />
        <activity android:name=".ui.quiz.QuizChoiceActivity" />

        <activity
            android:name=".ui.profile.AboutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.HowToUseActivity"
            android:exported="false" />

        <activity
            android:name=".ui.game.MemoryGameActivity"
            android:exported="false" />

        <activity android:name=".ui.quiz.QuizResultActivity" />

        <activity
            android:name=".ui.game.FlappySignActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>

</manifest>